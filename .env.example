# Required – Neon connection string (Neon console → project → Connect → "Pooled connection")
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Recommended once deployed – a passcode so only you can open the app
APP_PASSCODE=

# Optional & free – Google AI Studio key for smarter goal plans (free tier, no card).
# Leave blank and THEO uses its built-in planner only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
